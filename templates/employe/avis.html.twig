{# templates/employe/avis.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Gestion des avis{% endblock %}

{% block body %}
    <h1>Gestion des avis (Employé)</h1>

    <ul>
        {% for avis in avisNonVisibles %}
            <li>
                <strong>{{ avis.pseudo }}</strong>: {{ avis.commentaire }}
                <a href="{{ path('employe_avis_valider', {'id': avis.id}) }}">Valider</a>
                <a href="{{ path('employe_avis_supprimer', {'id': avis.id}) }}">Supprimer</a>
            </li>
        {% endfor %}
    </ul>
    <form action="{{ path('app_logout') }}" method="post">
        <button type="submit" class="btn btn-danger">Se déconnecter</button>
    </form>    
    <a href="{{ path('employe_dashboard') }}" class="btn btn-secondary mt-3">Retour au tableau de bord</a>
{% endblock %}

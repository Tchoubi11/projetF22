{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - Employé{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="text-center">Tableau de bord - Employé</h1>

    <!--  section pour gérer les avis -->
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Gérer les avis</h5>
                    <p class="card-text">Consultez, validez ou supprimez les avis des visiteurs.</p>
                    <a href="{{ path('employe_avis') }}" class="btn btn-primary">Accéder</a>
                </div>
            </div>
        </div>
        
    </div>

    <!--  section pour gérer l'alimentation -->
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Gérer l'Alimentation</h5>
                    <p class="card-text">Ajoutez ou consultez les informations sur l'alimentation des animaux.</p>
                    <a href="{{ path('employe_alimentation_index') }}" class="btn btn-primary">Consulter les consommations</a>
                    <a href="{{ path('employe_alimentation_new') }}" class="btn btn-secondary ">Ajouter une consommation</a>
                </div>
            </div>
        </div>
    </div>
</div>
<form action="{{ path('app_logout') }}" method="post">
    <button type="submit" class="btn btn-danger">Se déconnecter</button>
</form>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - Employé{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="text-center">Tableau de bord - Employé</h1>

    <!--  section pour gérer les avis, les services et l'alimentation sur la même ligne -->
    <div class="row mt-4">
        <!-- Gérer les avis -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Gérer les avis</h5>
                    <p class="card-text">Consultez, validez ou supprimez les avis des visiteurs.</p>
                    <a href="{{ path('employe_avis') }}" class="btn btn-primary">Accéder</a>
                </div>
            </div>
        </div>

        <!-- Gérer les services -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Gérer les services</h5>
                    <p class="card-text">Consultez et gérez les services du zoo.</p>
                    <a href="{{ path('admin_service_index') }}" class="btn btn-primary">Voir les services</a>
                    <a href="{{ path('admin_service_new') }}" class="btn btn-secondary mt-2">Ajouter un service</a>
                </div>
            </div>
        </div>

        <!-- Gérer l'Alimentation -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Gérer l'Alimentation</h5>
                    <p class="card-text">Ajoutez ou consultez les informations sur l'alimentation des animaux.</p>
                    <a href="{{ path('employe_alimentation_index') }}" class="btn btn-primary">Consulter les consommations</a>
                    <a href="{{ path('employe_alimentation_new') }}" class="btn btn-secondary mt-2">Ajouter une consommation</a>
                </div>
            </div>
        </div>
    </div>
<!-- Lien vers l'accueil -->
<div class="d-flex justify-content-between mt-4">
    <!-- Lien vers l'accueil -->
    <a href="{{ path('app_home') }}" class="btn btn-primary">Retour à l'accueil</a>

    <!-- Formulaire de déconnexion -->
    <form action="{{ path('app_logout') }}" method="post">
        <button type="submit" class="btn btn-danger">Se déconnecter</button>
    </form>
</div>

{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Consommations alimentaires{% endblock %}

{% block body %}
<h1>Consommations alimentaires</h1>

<a href="{{ path('employe_alimentation_new') }}">Ajouter une consommation</a>

<table>
    <thead>
        <tr>
            <th>Animal</th>
            <th>Date et heure</th>
            <th>Nourriture</th>
            <th>grammage (kg)</th>
        </tr>
    </thead>
    <tbody>
        {% for alimentation in alimentations %}
            <tr>
                <td>{{ alimentation.animal.prenom }}</td>
                <td>{{ alimentation.dateHeure|date('d/m/Y H:i') }}</td>
                <td>{{ alimentation.nourriture }}</td>
                <td>{{ alimentation.grammage }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
<form method="post" action="{{ path('app_logout') }}">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
    <button type="submit" class="btn btn-danger">Se déconnecter</button>
</form>
<a href="{{ path('employe_dashboard') }}" class="btn btn-secondary mt-3">Retour au tableau de bord</a>
{% endblock %}

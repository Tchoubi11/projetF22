<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zoo de Arcadia - Accueil</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}">
   
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="{{ path('app_home') }}">Arcadia Zoo</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="{{ path('app_home') }}">Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_services') }}">Services</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_habitats') }}">Habitats</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_contact') }}">Contact</a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_login') }}">Connexion</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    

<div class="container mt-5">
    <!-- Présentation -->
    <section class="mb-5">
        <h2 class="text-center">Bienvenue au Zoo Arcadia</h2>
        <p class="text-center">Arcadia est un Zoo situé en France près de la forêt de Brocéliande,en bretagne depuis 1960 . </p>
        <p class="text-center">Ils possèdent tout un panel d'animaux, réparti par habitat(savane,jungle,marais) et font extrêmement attention à leurs santés avec des visites quotidiennes de plusieurs vétérinaires et un contrôle du grammage lors des repas .</p>
    </section>

    <!-- Galerie d'images -->
  
<section class="mb-5">
    <h3 class="text-center">Galerie d'images</h3>
    <div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">
        <!-- Indicateurs -->
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="3" aria-label="Slide 4"></button>
        </div>

        <!-- Slides -->
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="/uploads/images/678418be0edb0.jpg" class="d-block w-100 img-fluid rounded" alt="Hippopotame">
                <div class="carousel-caption d-none d-md-block">
                    <h5>Girafe</h5>
                </div>
            </div>
            <div class="carousel-item">
                <img src="/uploads/images/678418f7c5213.jpg" class="d-block w-100 img-fluid rounded" alt="Singe">
                <div class="carousel-caption d-none d-md-block">
                    <h5>Antilope</h5>
                </div>
            </div>
            <div class="carousel-item">
                <img src="/uploads/images/678419e9af3c4.jpg" class="d-block w-100 img-fluid rounded" alt="Antilope">
                <div class="carousel-caption d-none d-md-block">
                    <h5>Singe</h5>
                </div>
            </div>
            <div class="carousel-item">
                <img src="/uploads/images/678418842e8e1.jpg" class="d-block w-100 img-fluid rounded" alt="Girafe">
                <div class="carousel-caption d-none d-md-block">
                    <h5>Hippopotame</h5>
                </div>
            </div>
        </div>

        <!-- Contrôles -->
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Précédent</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Suivant</span>
        </button>
    </div>
</section>


    <!-- Section des habitats -->
    <section class="row">
        <div class="col-md-6">
            <h3 class="text-center">Habitats</h3>
            <ul class="list-group">
                {% for habitat, animals in habitats %}
                    <li class="list-group-item">
                        <strong>{{ habitat }}</strong>: {{ animals | join(', ') }}
                    </li>
                {% endfor %}
            </ul>
        </div>
 
    <!-- Section des services -->
   
        <div class="col-md-6">
            <h3 class=" text-center">Nos Services</h3>
            <ul class="list-group">
        {% for service in services %}
            <li class="list-group-item">
                <strong>{{ service }}</strong>
            </li>
        {% endfor %}
           </ul>
        </div>
    </section>
</div>

 <!-- Avis des visiteurs -->
 <section class="mb-5">
    <h3 class="text-center">Avis des visiteurs</h3>
    <div class="list-group">
        {% for review, author in reviews %}
            <div class="list-group-item">
                <p>"{{ review }}"</p>
                <small class="text-muted">- {{ author }}</small>
            </div>
        {% endfor %}
    </div>
</section>
<footer class="bg-dark text-white text-center py-3 mt-5">
    &copy; {{ "now"|date("Y") }} Zoo Arcadia. Tous droits réservés.
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

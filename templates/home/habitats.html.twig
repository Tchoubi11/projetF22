{% extends 'base.html.twig' %}

{% block title %}Habitats{% endblock %}

{% block body %}
<h1>Les Habitats</h1>
<div class="habitats-container">
    {% for habitat in habitats %}
        <div class="habitat-card">
            <a href="{{ path('habitat_detail', { id: habitat.id }) }}">
                {% for image in habitat.images %}
                <img src="{{ asset(image.imagePath|replace({'public/': ''})) }}" alt="{{ habitat.nom }}" />

                {% endfor %}
                <h2>{{ habitat.nom }}</h2>
            </a>
        </div>
        
    {% endfor %}
</div>
<div class="home-link">
    <a href="{{ path('app_home') }}" class="btn btn-secondary">Retour à l'accueil</a>
</div>

{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Habitats{% endblock %}

{% block body %}
<h1>Les Habitats</h1>
<div class="habitats-container">
    {% for habitat in habitats %}
        <div class="habitat-card">
            <a href="{{ path('habitat_detail', { id: habitat.id }) }}">
                {% for image in habitat.images %}
                    <img src="{{ asset(image.imagePath) }}" alt="{{ habitat.nom }}" />
                {% endfor %}
                <h2>{{ habitat.nom }}</h2>
            </a>
        </div>
    {% endfor %}
</div>
{% endblock %}

<style>
.habitats-container {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
}

.habitat-card {
    width: 200px;
    text-align: center;
}

.habitat-card img {
    width: 100%;
    height: auto;
    border-radius: 8px;
}
</style>

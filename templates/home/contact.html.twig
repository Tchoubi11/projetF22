{% extends 'base.html.twig' %}

{% block title %}Contact - Zoo Arcadia{% endblock %}

{% block body %}
<div class="container mt-5">
    <h2 class="text-center">Contactez-nous</h2>
    <div class="row mt-4">
        {% for contact in contacts %}
            <div class="col-md-4">
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">{{ contact.name }}</h5>
                        <p class="card-text">
                            <strong>Mission:</strong> {{ contact.mission }}<br>
                            <strong>Email:</strong> <a href="mailto:{{ contact.email }}">{{ contact.email }}</a><br>
                            <strong>Téléphone:</strong> {{ contact.phone }}
                        </p>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

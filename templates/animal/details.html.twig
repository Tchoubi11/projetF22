{% extends 'base.html.twig' %}

{% block title %}Détails de l'animal{% endblock %}

{% block body %}
<div class="animal-details">
    <h1>Détails de l'animal : {{ details.prenom }}</h1>
    
    <div class="animal-image">
        <img src="{{ details.imageUrl }}" alt="Image de {{ details.prenom }}" style="max-width: 300px; border-radius: 10px;">
    </div>
    
    <div class="animal-info">
        <h2>Informations générales</h2>
        <ul>
            <li><strong>Prénom :</strong> {{ details.prenom }}</li>
            <li><strong>État :</strong> {{ details.etat }}</li>
            <li><strong>Nourriture :</strong> {{ details.nourriture }}</li>
            <li><strong>Grammage :</strong> {{ details.grammage }}</li>
            <li><strong>Date de passage vétérinaire :</strong> {{ details.dateDePassage }}</li>
            <li><strong>Avis vétérinaire :</strong> {{ details.avisVeterinaire }}</li>
        </ul>
    </div>
</div>

<div class="back-link">
    <a href="{{ path('app_habitats') }}" class="btn btn-primary">Retour aux habitats</a>
</div>

{% endblock %}

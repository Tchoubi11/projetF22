{% extends 'base.html.twig' %}

{% block title %}Détails de l'habitat - {{ habitat.nom }}{% endblock %}

{% block body %}
<h1>{{ habitat.nom }}</h1>

<div class="habitat-detail">
    {% if habitat.images is not empty %}
        {% for image in habitat.images %}
            <img src="{{ asset(image.imagePath|replace({'public/': ''})) }}" alt="{{ habitat.nom }}">
        {% endfor %}
    {% endif %}
    <p>{{ habitat.description }}</p>
</div>

<h2>Animaux associés</h2>
<div class="animaux-container">
    {% for animal in animaux %}
        <div class="animal-card">
            <!-- Image de l'animal -->
            <img 
                src="{{ asset(animal.image|replace({'public/': ''})) }}" 
                alt="{{ animal.prenom }}" 
                style="max-width: 300px; border-radius: 10px; cursor: pointer;" 
                class="animal-image" 
                data-animal-id="{{ animal.id }}"
            >
            <h3>{{ animal.prenom }}</h3>
            <p>État : {{ animal.etat }}</p>

            <!-- Détails de l'animal (coulissement au clic) -->
            <div class="animal-info" id="details-{{ animal.id }}" style="max-height: 0; overflow: hidden; transition: max-height 0.5s ease-out;">
                <h4>Détails de {{ animal.prenom }}</h4>
                <ul>
                    
                    <li><strong>Nourriture :</strong> {{ animal.nourriture ?? 'Non spécifiée' }}</li>
                    <li><strong>Grammage :</strong> {{ animal.grammage ?? 'Non spécifié' }}</li>
                    <li><strong>Date de passage vétérinaire :</strong> {{ animal.dateDePassage ?? 'Non spécifiée' }}</li>
                    <li><strong>Avis vétérinaire :</strong> {{ animal.avisVeterinaire ?? 'Non disponible' }}</li>
                </ul>
            </div>
        </div>
    {% endfor %}
</div>

<div class="back-link">
    <a href="{{ path('app_habitats') }}" class="btn btn-primary">Retour aux habitats</a>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.animal-image').forEach((image) => {
            image.addEventListener('click', () => {
                const animalId = image.getAttribute('data-animal-id');
                const detailsDiv = document.getElementById(`details-${animalId}`);
                const isOpen = detailsDiv.style.maxHeight !== '0px' && detailsDiv.style.maxHeight !== '';

                if (isOpen) {
                    detailsDiv.style.maxHeight = '0'; // Masquer les détails
                } else {
                    detailsDiv.style.maxHeight = detailsDiv.scrollHeight + 'px'; // Afficher les détails
                }
            });
        });
    });
    const images = document.querySelectorAll('.animal-card img');  // Suppose que les images sont dans .animal-card
    const details = document.querySelectorAll('.animal-info'); // Suppose que chaque carte a un élément .animal-info

    images.forEach((image, index) => {
        image.addEventListener('click', () => {
            const detail = details[index];

            // Si les détails sont déjà visibles, les cacher
            if (detail.classList.contains('show')) {
                detail.classList.remove('show');
            } else {
                // Cacher tous les autres détails
                details.forEach(d => d.classList.remove('show'));

                // Afficher celui de l'animal en cliquant
                detail.classList.add('show');
            }
        });
    });
</script>

{% endblock %}

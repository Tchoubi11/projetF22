{% extends 'base.html.twig' %}

{% block title %}Détails de l'habitat - {{ habitat.nom }}{% endblock %}

{% block body %}
<h1>{{ habitat.nom }}</h1>

<div class="habitat-detail">
    {% if habitat.images is not empty %}
        {% for image in habitat.images %}
            <img src="{{ asset(image.imagePath|replace({'public/': ''})) }}" alt="{{ habitat.nom }}">
        {% endfor %}
    {% endif %}
    <p>{{ habitat.description }}</p>
</div>

<h2>Animaux associés</h2>
<div class="animaux-container">
    {% for animal in animaux %}
    <div class="animal-card">
        <!-- Image de l'animal -->
        <img 
    src="{{ asset(animal.image|replace({'public/': ''})) }}" 
    alt="{{ animal.prenom }}" 
    class="animal-image" 
    data-animal-prenom="{{ animal.prenom }}" 
>


        <!-- Détails de l'animal -->
        <h3>{{ animal.prenom }}</h3>
        <p>État : {{ animal.etat }}</p>

        <!-- Compteur de vues -->
        <div>
            <strong>Vues :</strong> 
            <span id="views-{{ animal.prenom }}">{{ animal.views }}</span>
        </div>
        
        <div class="animal-info" id="details-{{ animal.prenom }}" 
             style="max-height: 0; overflow: hidden; transition: max-height 0.5s ease-out;">
            <h4>Détails de {{ animal.prenom }}</h4>
            <ul>
                <li><strong>Nourriture :</strong> {{ animal.nourriture ?? 'Non spécifiée' }}</li>
                <li><strong>Grammage :</strong> {{ animal.grammage ?? 'Non spécifié' }}</li>
                <li><strong>Date de passage vétérinaire :</strong> {{ animal.dateDePassage ?? 'Non spécifiée' }}</li>
                <li><strong>Avis vétérinaire :</strong> {{ animal.avisVeterinaire ?? 'Non disponible' }}</li>
            </ul>
        </div>
        
    </div>
    {% endfor %}
</div>

<div class="back-link">
    <a href="{{ path('app_habitats') }}" class="btn btn-primary">Retour aux habitats</a>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".animal-image").forEach((image) => {
        image.addEventListener("click", async () => {
            const animalPrenom = image.getAttribute("data-animal-prenom");
            console.log("Prénom envoyé au serveur :", animalPrenom); // Vérification
            const detailsDiv = document.getElementById(`details-${animalPrenom}`);
            const viewsElement = document.getElementById(`views-${animalPrenom}`);

            viewsElement.textContent = "Chargement...";

            try {
                const response = await fetch(`/animalDocument/incrementByPrenom/${animalPrenom}`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                });

                if (!response.ok) {
                    const errorData = await response.json();
                    console.error("Erreur serveur :", errorData);
                    throw new Error(errorData.error || `Erreur serveur : ${response.statusText}`);
                }

                const data = await response.json();
                console.log("Réponse reçue du serveur :", data); // Débogage
                viewsElement.textContent = data.views;
            } catch (error) {
                console.error("Erreur lors de la mise à jour :", error);
                viewsElement.textContent = "Erreur de mise à jour";
            }

            if (detailsDiv) {
                detailsDiv.style.maxHeight = detailsDiv.classList.contains("show") ? "0" : detailsDiv.scrollHeight + "px";
                detailsDiv.classList.toggle("show");
            }
        });
    });
});

</script>


{% endblock %}

{% extends 'base.html.twig' %}


{% block title %}Modifier les rôles{% endblock %}

{% block body %}
    <h1>Modifier les rôles pour {{ user.username }}</h1>

    {{ form_start(form) }}
        {{ form_row(form.roles) }}
        <button class="btn btn-primary mt-3">Enregistrer</button>
    {{ form_end(form) }}

    <a href="{{ path('user_list') }}" class="btn btn-secondary mt-3">Retour à la liste</a>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Gestion des Services{% endblock %}

{% block body %}
<h1>Services proposés</h1>

<a href="{{ path('admin_service_new') }}">Ajouter un service</a>
<form action="{{ path('app_logout') }}" method="post">
    <button type="submit" class="btn btn-danger">Se déconnecter</button>
</form>



<table>
    <thead>
        <tr>
            <th>Nom</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for service in services %}
            <tr>
                <td>{{ service.nom }}</td>
                <td>{{ service.description }}</td>
                <td>
                    <a href="{{ path('admin_service_edit', {'id': service.id}) }}">Modifier</a>
                    <form method="post" action="{{ path('admin_service_delete', {'id': service.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce service ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ service.id) }}">
                        <button type="submit">Supprimer</button>
                    </form>
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>
<!-- Si l'utilisateur est admin, on affiche le bouton -->
{% if is_granted('ROLE_ADMIN') %}
    <a href="{{ path('admin_dashboard') }}" class="btn btn-secondary mt-3">Retour au tableau de bord</a>
{% endif %}

<!-- Si l'utilisateur est employé,on affiche le bouton sauf sur la page 'admin_service_index' -->
{% if is_granted('ROLE_EMPLOYE') and app.request.attributes.get('_route') != 'admin_service_index' %}
    <a href="{{ path('admin_dashboard') }}" class="btn btn-secondary mt-3">Retour au tableau de bord</a>
{% endif %}
{% endblock %}


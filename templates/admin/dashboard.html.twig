{% extends 'base.html.twig' %}

{% block title %}Statistiques des Animaux{% endblock %}

{% block body %}
<h1>Statistiques des Animaux</h1>
<table>
    <thead>
        <tr>
            <th>Prénom</th>
            <th>Consultations</th>
        </tr>
    </thead>
    <tbody>
        {% for animal in statistics %}
        <tr>
            <td>{{ animal.prenom }}</td>
            <td>{{ animal.views }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Détails du Rapport Vétérinaire{% endblock %}

{% block body %}
    <h1>Détails du Rapport Vétérinaire</h1>

    <p><strong>ID :</strong> {{ rapport.id }}</p>
    <p><strong>Animal :</strong> {{ rapport.animal.prenom }}</p>
    <p><strong>Date :</strong> {{ rapport.date ? rapport.date|date('d/m/Y') : 'N/A' }}</p>
    <p><strong>Observations :</strong> {{ rapport.observations }}</p>
    <p><strong>Commentaires sur l'Habitat :</strong> {{ rapport.habitatComment }}</p>

    <h2>Alimentation</h2>
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Nourriture</th>
            </tr>
        </thead>
        <tbody>
            {% if rapport.feedings is not empty %}
                {% for feeding in rapport.feedings %}
                    <tr>
                        <td>{{ feeding.date|date('d/m/Y H:i') }}</td>
                        <td>{{ feeding.food }}</td>
                    </tr>
                {% endfor %}
            {% else %}
                <tr>
                    <td colspan="2">Aucune donnée d'alimentation disponible.</td>
                </tr>
            {% endif %}
        </tbody>
    </table>

    <a href="{{ path('rapport_veterinaire_list') }}" class="btn btn-secondary">Retour à la liste</a>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Liste des Rapports Vétérinaires{% endblock %}

{% block body %}
    <h1>Liste des Rapports Vétérinaires</h1>

    <a href="{{ path('rapport_veterinaire_new') }}" class="btn btn-primary">Créer un nouveau rapport</a>

    <table class="table mt-3">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nom de l'Animal</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for rapport in rapports %}
                <tr>
                    <td>{{ rapport.id }}</td>
                    <td>{{ rapport.animal.prenom }}</td>
                    <td>{{ rapport.date ? rapport.date|date('d/m/Y') : 'N/A' }}</td>
                    <td>
                        <a href="{{ path('rapport_veterinaire_show', { id: rapport.id }) }}" class="btn btn-info btn-sm">Voir</a>
                        <form method="post" action="{{ path('rapport_veterinaire_delete', { id: rapport.id }) }}" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce rapport ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rapport.id) }}">
                            <button class="btn btn-danger btn-sm">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    <form method="post" action="{{ path('app_logout') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
        <button type="submit" class="btn btn-danger">Se déconnecter</button>
    </form>
    
{% endblock %}

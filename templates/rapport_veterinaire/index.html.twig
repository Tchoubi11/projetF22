{% extends 'base.html.twig' %}

{% block title %}Liste des Rapports Vétérinaires{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="text-center">Liste des Rapports Vétérinaires</h1>

    {# Formulaire de filtrage par animal #}
    {{ form_start(form) }}
        <div class="mb-3">
            {{ form_label(form.animal, 'Sélectionner un animal :') }}
            {{ form_widget(form.animal, { 'attr': { 'class': 'form-control' } }) }}
        </div>
        <button class="btn btn-primary" type="submit">Filtrer</button>
    {{ form_end(form) }}

    {% if animal %}
    <a href="{{ path('rapport_veterinaire_new', { id: animal.id }) }}" class="btn btn-success">
        Ajouter un rapport pour {{ animal.prenom }}
    </a>
{% endif %}


    <table class="table mt-3">
        <thead>
            <tr>
                <th>Date</th>
                <th>Détails</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for rapport in rapports %}
                <tr>
                    <td>{{ rapport.date|date('d/m/Y') }}</td>
                    <td>{{ rapport.detail }}</td>
                    <td>
                        <a href="{{ path('rapport_veterinaire_show', { id: rapport.id }) }}">Voir le rapport</a>

                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="text-center">Aucun rapport trouvé.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    <div class="mt-4">
        <a href="{{ path('veterinaire_dashboard') }}" class="btn btn-secondary">Retour au tableau de bord</a>
    </div>
</div>
{% endblock %}

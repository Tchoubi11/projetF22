{% extends 'base.html.twig' %}

{% block title %}Liste des Rapports Vétérinaires{% endblock %}

{% block body %}
<h1>Liste des Rapports Vétérinaires</h1>

{% if animal %}
    <a href="{{ path('rapport_veterinaire_new', { id: animal.id }) }}" class="btn btn-primary">Créer un nouveau rapport</a>
{% else %}
    <p class="text-danger">Aucun animal sélectionné. Impossible de créer un rapport.</p>
{% endif %}

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nom de l'Animal</th>
            <th>Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for rapport in rapports %}
            <tr>
                <td>{{ rapport.id }}</td>
                <td>{{ rapport.animal ? rapport.animal.prenom : 'Non spécifié' }}</td>
                <td>{{ rapport.date|date('d/m/Y') }}</td>
                <td>
                    <a href="{{ path('rapport_veterinaire_show', { id: rapport.id }) }}" class="btn btn-info btn-sm">Voir</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Aucun rapport vétérinaire enregistré.</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
<a href="{{ path('veterinaire_dashboard') }}" class="btn btn-secondary mt-3">Retour au tableau de bord</a>
{% endblock %}

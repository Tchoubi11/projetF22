{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - Vétérinaire{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="text-center">Tableau de bord - Vétérinaire</h1>
    
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Liste des animaux</h5>
                    <p class="card-text">Consultez et mettez à jour les informations médicales des animaux.</p>
                    
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Rapports vétérinaires</h5>
                    <p class="card-text">Créer et gérer les rapports vétérinaires pour les animaux.</p>
                    <!-- Lien vers la liste des rapports vétérinaires -->
                    <a href="{{ path('rapport_veterinaire_list') }}" class="btn btn-primary">Voir les rapports</a>
                    <!-- Lien pour ajouter un nouveau rapport vétérinaire -->
                    <a href="{{ path('rapport_veterinaire_new', {'id': 1}) }}" class="btn btn-success ">Ajouter un rapport</a> <!-- Remplacer 1 par un ID d'animal existant -->
                </div>
            </div>
        </div>
    </div>

    
</div>
<form action="{{ path('app_logout') }}" method="post">
    <button type="submit" class="btn btn-danger">Se déconnecter</button>
</form>
{% endblock %}

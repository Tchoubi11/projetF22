{% extends 'base.html.twig' %}

{% block title %}Créer un Rapport Vétérinaire{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="text-center">Créer un Rapport Vétérinaire</h1>

    <form method="post">
        {{ form_start(form) }}

        <div class="mb-3">
            <label class="form-label">Date du rapport :</label>
            {{ form_widget(form.date, { 'attr': { 'class': 'form-control' } }) }}
            {{ form_errors(form.date) }} 
        </div>

        <div class="mb-3">
            <label class="form-label">Choisir un animal :</label>
            {{ form_widget(form.animal, { 'attr': { 'class': 'form-control' } }) }}
            {{ form_errors(form.animal) }}
        </div>

        <div class="mb-3">
            <label class="form-label">Commentaires sur l'habitat :</label> 
            {{ form_widget(form.habitatComment, { 'attr': { 'class': 'form-control' } }) }}
            {{ form_errors(form.habitatComment) }}
        </div>

        <div class="mb-3">
            <label class="form-label">Détails :</label>
            {{ form_widget(form.detail, { 'attr': { 'class': 'form-control' } }) }}
            {{ form_errors(form.detail) }}
        </div>
        

        
        
        <div id="feedings-container">
            <div id="champ_alimentation_animal">

            </div>
        </div>   
         
        <button type="button" class="btn btn-success" id="add-feeding">Ajouter un aliment</button>
 
        <div class="mt-3">
            {{ form_widget(form.save, { 'attr': { 'class': 'btn btn-primary' } }) }}
        </div>

        
        {% set feedingPrototype = form_widget(form.feedings.vars.prototype)|raw %}

        {{ form_end(form) }}
    </form>

    <div id="feeding-prototype" style="display: none;" data-prototype="{{ feedingPrototype|e('html_attr') }}"></div>

</div>

<div class="mt-4">
    <a href="{{ path('veterinaire_dashboard') }}" class="btn btn-secondary">Retour au tableau de bord</a>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    var feedingContainer = document.getElementById('feedings-container'); 
    var feedingPrototype = document.getElementById('feeding-prototype').dataset.prototype;

    function addFeeding() {
        var index = feedingContainer.querySelectorAll('.feeding-item').length;
        var newField = feedingPrototype.replace(/__name__/g, index);

        var newElement = document.createElement('div');
        newElement.classList.add('feeding-item', 'mb-3', 'p-3', 'border', 'rounded');
        newElement.innerHTML = newField + 
            '<button type="button" class="btn btn-danger remove-feeding mt-2">Supprimer</button>';

        feedingContainer.appendChild(newElement);
    }

    // Ajout d'un aliment au clic
    document.getElementById('add-feeding').addEventListener('click', function () {
        addFeeding();
    });

    // Suppression d'un aliment
    feedingContainer.addEventListener('click', function (event) {
        if (event.target.classList.contains('remove-feeding')) {
            event.target.closest('.feeding-item').remove();
        }
    });
});

let champAnimal = document.getElementById('rapport_veterinaire_animal');

champAnimal.addEventListener('change',function(event){

 let animalId =event.target.value;
 
 champAnimal.value = animalId;


 let xhr = new XMLHttpRequest();
 xhr.open('GET','https://localhost:8000/rapport_veterinaire/get-alimentation/'+animalId);
 xhr.responseType='json';
 xhr.send();
// xhr.onload() =function(){
//    console.log(xhr.response)
// }   
//console.log(xhr.response);
xhr.onreadystatechange = ()=>{
    if(xhr.readyState==4){
        console.log(xhr.response);
        let divAlimentationAnimal = document.getElementById('champ_alimentation_animal');
        divAlimentationAnimal.innerHTML=xhr.response.html;
        
    }
}


})




</script>

{% endblock %}

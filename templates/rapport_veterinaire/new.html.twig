{% extends 'base.html.twig' %}

{% block title %}Créer un Rapport Vétérinaire{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="text-center">Créer un Rapport Vétérinaire</h1>

    <form method="post">
        {{ form_start(form) }}

        <div class="mb-3">
            <label class="form-label">Date du rapport :</label>
            {{ form_widget(form.date, { 'attr': { 'class': 'form-control' } }) }}
        </div>

        <div class="mb-3">
            <label class="form-label">Choisir un animal :</label>
            {{ form_widget(form.animal, { 'attr': { 'class': 'form-control' } }) }}
        </div>

        <div class="mb-3">
            <label class="form-label">Commentaires sur l'habitat :</label>
            {{ form_widget(form.habitatComment, { 'attr': { 'class': 'form-control' } }) }}
        </div>

        <div class="mb-3">
            <label class="form-label">Détails :</label>
            {{ form_widget(form.detail, { 'attr': { 'class': 'form-control' } }) }}
        </div>

       




        <h2>Alimentation</h2>
        <div id="feedings-container">
            {% for feeding in form.feedings %}
            <div class="feeding-item">
                <div class="mb-3">
                    {{ form_label(feeding.feedingTime, 'Heure du repas :', { 'class': 'form-label' }) }}
                    {{ form_widget(feeding.feedingTime, { 'attr': { 'class': 'form-control' } }) }}
                </div>
            
                <div class="mb-3">
                    {{ form_label(feeding.food, 'Nourriture :', { 'class': 'form-label' }) }}
                    {{ form_widget(feeding.food, { 'attr': { 'class': 'form-control' } }) }}
                </div>
            
                <div class="mb-3">
                    {{ form_label(feeding.quantity, 'Quantité :', { 'class': 'form-label' }) }}
                    {{ form_widget(feeding.quantity, { 'attr': { 'class': 'form-control' } }) }}
                </div>
            
                <button type="button" class="btn btn-danger remove-feeding">Supprimer</button>
            </div>
            
        {% else %}
            <p>Aucun aliment ajouté.</p>
        {% endfor %}
        
        </div>

        <button type="button" class="btn btn-success" id="add-feeding">Ajouter un aliment</button>
        
 
        <div class="mt-3">
            {{ form_widget(form.save, { 'attr': { 'class': 'btn btn-primary' } }) }}
        </div>

        {# ici je stocke le prototype#}
        {% set feedingPrototype = form_widget(form.feedings.vars.prototype)|raw %}

        {{ form_end(form) }}
    </form>

    {# Affichage du prototype dans une div cachée #}
    <div id="feeding-prototype" style="display: none;" data-prototype="{{ feedingPrototype|e('html_attr') }}"></div>

</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    var feedingContainer = document.getElementById('feedings-container'); 
    var feedingPrototype = document.getElementById('feeding-prototype').dataset.prototype; // j'utilise dataset pour récupérer le prototype

    function addFeeding() {
        var index = feedingContainer.querySelectorAll('.feeding-item').length; // on compte les éléments existants
        var newField = feedingPrototype.replace(/__name__/g, index); //on remplace __name__ par l'index unique

        var newElement = document.createElement('div');
        newElement.classList.add('feeding-item', 'mb-3', 'p-3', 'border', 'rounded'); // Ajout du style pour la lisibilité
        newElement.innerHTML = newField + 
            '<button type="button" class="btn btn-danger remove-feeding mt-2">Supprimer</button>';

        feedingContainer.appendChild(newElement);
    }

    // Ajout d'un aliment au clic
    document.getElementById('add-feeding').addEventListener('click', function () {
        addFeeding();
    });

    // Suppression d'un aliment
    feedingContainer.addEventListener('click', function (event) {
        if (event.target.classList.contains('remove-feeding')) {
            event.target.closest('.feeding-item').remove();
        }
    });
});
</script>

{% endblock %}
